[Unit]
Description=AETHER-X 01 Pi USB link and optional locked smartphone UI
Wants=network-online.target
After=network-online.target
[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=dialout
EnvironmentFile=-/etc/aether/phone.env
WorkingDirectory=/opt/aether
ExecStart=/opt/aether/.venv/bin/python -m rover.service
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
[Install]
WantedBy=multi-user.target
